# Copy this file to .env and fill in your own values

# Your MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://jainriya6824_db_user:LRmI4S4hQNDYqV5H@cluster0.xv4zx4t.mongodb.net

# Port the API server runs on
PORT=5000

# Comma separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign login tokens — use a long random string in production
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long a login session lasts
JWT_EXPIRES_IN=7d
